// =============================================================================
// VomeSync — CI Pipeline
//
// Stages: Setup → Quality Gates (ESLint, npm audit, shellcheck) →
//         Tests (webserver unit + integration + coverage)
//
// HA integration / add-on CI lives in Vortitron/VomeSync.
// =============================================================================

pipeline {
    agent any

    options {
        ansiColor('xterm')
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10', daysToKeepStr: '14'))
    }

    // A declarative triggers block self-registers on the job every time this
    // pipeline runs, which is why pollSCM is not here: it would put the trigger
    // straight back after any change made in casc.yaml.  It is gone because the
    // git plugin reports "Working Directory does not exist -> Changes found" on
    // every poll of these jobs, so a five-minute poll ran a full CI build every
    // five minutes forever -- thousands of them -- whether or not anything had
    // changed.  The GitHub webhook is what triggers these jobs.
    triggers {
        githubPush()
    }

    parameters {
        booleanParam(
            name: 'FORCE_RUN',
            defaultValue: false,
            description: 'Run full CI even when no SCM changes are detected'
        )
    }

    environment {
        RUN_MAIN_PIPELINE = 'true'
        NODE_OPTIONS = '--max-old-space-size=2048'

        // redis-memory-server compiles redis-server from source during `npm ci`
        // and caches it under the workspace — which `cleanWs()` deletes at the
        // end of every build, so each build paid for a fresh compile. Point the
        // cache at JENKINS_HOME so it survives, and one compile serves every
        // later build. (The version is pinned in webserver/package.json: the
        // default, "stable", is now Redis 8.x, whose tarball bundles modules
        // that need cmake and rustc — neither of which is in the agent image.)
        REDISMS_DOWNLOAD_DIR = "${env.JENKINS_HOME}/.cache/redis-memory-server"
    }

    stages {
        stage('Scope Check') {
            steps {
                script {
                    def forceRun = (params.FORCE_RUN ?: false)
                    def changedFiles = []

                    for (def changeSet in currentBuild.changeSets) {
                        for (def entry in changeSet.items) {
                            for (def file in entry.affectedFiles) {
                                changedFiles << file.path
                            }
                        }
                    }

                    def hasChanges = !changedFiles.isEmpty()
                    def firstBuild = (currentBuild.number == 1)

                    if (forceRun || hasChanges || firstBuild) {
                        env.RUN_MAIN_PIPELINE = 'true'
                        echo "VomeSync CI enabled (force=${forceRun}, hasChanges=${hasChanges}, firstBuild=${firstBuild}, changedFiles=${changedFiles.size()})"
                    } else {
                        env.RUN_MAIN_PIPELINE = 'false'
                        currentBuild.description = 'No SCM changes'
                        echo 'No SCM changes detected. Skipping heavy CI stages.'
                    }
                }
            }
        }

        stage('Setup') {
            when {
                expression { env.RUN_MAIN_PIPELINE == 'true' }
            }
            steps {
                sh '''
                    echo "── Node.js ──"
                    node --version
                    npm --version
                    echo "── Python (system) ──"
                    python3 --version
                    echo "── Python 3.11 ──"
                    python3.11 --version
                '''
                dir('webserver') {
                    sh 'npm ci'
                }
            }
        }

        stage('Quality Gates') {
            when {
                expression { env.RUN_MAIN_PIPELINE == 'true' }
            }
            parallel {
                stage('ESLint') {
                    steps {
                        dir('webserver') {
                            sh '''
                                echo "── ESLint ──"
                                npm run lint || true
                            '''
                        }
                    }
                }

                stage('Security') {
                    steps {
                        dir('webserver') {
                            sh '''
                                echo "── npm audit ──"
                                npm audit --audit-level=high || true
                            '''
                        }
                    }
                }

                stage('Shell Check') {
                    steps {
                        sh '''
                            echo "── shellcheck ──"
                            find scripts/ -name '*.sh' -print0 2>/dev/null | \
                                xargs -0 --no-run-if-empty shellcheck --severity=warning || true

                            echo ""
                            echo "── bash syntax ──"
                            bash -n docker/scripts/deploy.sh
                            bash -n scripts/run-tests.sh
                        '''
                    }
                }
            }
        }

        stage('Tests') {
            when {
                expression { env.RUN_MAIN_PIPELINE == 'true' }
            }
            parallel {
                stage('Webserver Unit Tests') {
                    steps {
                        dir('webserver') {
                            sh 'npm run test:unit -- --ci --forceExit'
                        }
                    }
                }

                stage('Webserver Integration Tests') {
                    steps {
                        dir('webserver') {
                            sh 'npm run test:integration -- --ci --forceExit'
                        }
                    }
                }
            }
        }

        stage('Coverage Report') {
            when {
                expression { env.RUN_MAIN_PIPELINE == 'true' }
            }
            steps {
                dir('webserver') {
                    sh 'npm run test:coverage -- --ci --forceExit || true'
                }
            }
            post {
                always {
                    script {
                        if (fileExists('webserver/coverage/lcov-report/index.html')) {
                            publishHTML(target: [
                                reportDir: 'webserver/coverage/lcov-report',
                                reportFiles: 'index.html',
                                reportName: 'VomeSync Webserver Coverage'
                            ])
                        }
                    }
                }
            }
        }

        stage('Skipped') {
            when {
                expression { env.RUN_MAIN_PIPELINE != 'true' }
            }
            steps {
                echo 'No repository changes detected. CI checks skipped for this run.'
            }
        }
    }

    post {
        success {
            echo '✓ VomeSync CI — all quality gates passed.'
        }
        failure {
            echo '✗ VomeSync CI — pipeline failed. Check the stage logs above.'
        }
        cleanup {
            cleanWs()
        }
    }
}
