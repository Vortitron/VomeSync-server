// =============================================================================
// VomeSync server — LIVE auto-deploy
//
// On every push to main, run CI, wait for an operator click in *this* job,
// then hand off to vomesync-deploy with TARGET=live and SKIP_APPROVAL.
//
// The approval lives here, not in vomesync-deploy: that job is shared with
// DEV and is serialised (disableConcurrentBuilds), so a LIVE build parked at
// an input inside it would block every DEV deploy for hours.
//
// Jenkins job: VomeSync/vomesync-autodeploy-live (provisioned from casc.yaml).
// =============================================================================

// Tell somebody the gate is open.  Best effort by construction: a
// notification that fails must never fail a deploy.  Set
// APPROVAL_NOTIFY_EMAIL in the Jenkins environment (jenkins/.env in the
// VomeHome repo) to switch it on; unset, it says so once and stays quiet.
void notifyApprovalPending(String what) {
	String to = env.APPROVAL_NOTIFY_EMAIL
	if (!to?.trim()) {
		echo 'APPROVAL_NOTIFY_EMAIL is not set, so no approval email was sent. Add it to jenkins/.env.'
		return
	}
	try {
		String body = "A deploy is waiting for you.\\n\\n${what}\\n\\nApprove or abort: ${env.BUILD_URL}input/\\n"
		writeFile file: 'approval-mail.json', text: (
			'{"sender":"noreply@vome.io","to":["' + to.trim() + '"],' +
			'"subject":"Approve: ' + what + '","text_body":"' + body + '"}'
		)
		withCredentials([string(credentialsId: 'portal-smtp2go-api-key', variable: 'SMTP_KEY')]) {
			sh '''
				set +x
				curl -s -X POST https://api.smtp2go.com/v3/email/send \
					-H "X-Smtp2go-Api-Key: $SMTP_KEY" \
					-H "Content-Type: application/json" \
					--data @approval-mail.json \
					-o /dev/null -w "approval email: http=%{http_code}\n" || true
			'''
		}
	} catch (err) {
		echo "Approval email failed (${err}). Carrying on -- the gate itself is unaffected."
	}
}

pipeline {
	agent any

	options {
		ansiColor('xterm')
		timestamps()
		timeout(time: 14, unit: 'HOURS')
		buildDiscarder(logRotator(numToKeepStr: '15', daysToKeepStr: '30'))
		disableConcurrentBuilds()
	}

	// A declarative triggers block self-registers on the job every time this
	// pipeline runs, which is why pollSCM is not here: it would put the trigger
	// straight back after any change made in casc.yaml.  It is gone because the
	// git plugin reports "Working Directory does not exist -> Changes found" on
	// every poll of these jobs, so a five-minute poll ran a full CI build every
	// five minutes forever -- thousands of them -- whether or not anything had
	// changed.  The GitHub webhook is what triggers these jobs.
	triggers {
		githubPush()
	}

	parameters {
		booleanParam(
			name: 'SKIP_TESTS',
			defaultValue: false,
			description: 'Skip the pre-flight CI run (emergency rollback only)'
		)
		booleanParam(
			name: 'SKIP_APPROVAL',
			defaultValue: false,
			description: 'Bypass the manual LIVE approval click. Only set true when GitHub branch protection (PR review + green CI) is enforced on main.'
		)
	}

	environment {
		DEPLOY_JOB_NAME = 'VomeSync/vomesync-deploy'
	}

	stages {
		stage('Resolve commit') {
			steps {
				script {
					env.DEPLOY_SHA = sh(
						script: 'git rev-parse --short HEAD',
						returnStdout: true,
					).trim()
					currentBuild.description = "→ LIVE @ ${env.DEPLOY_SHA}"
					echo "Auto-deploying ${env.DEPLOY_SHA} to LIVE"
				}
			}
		}

		stage('Pre-flight CI') {
			when {
				expression { !params.SKIP_TESTS }
			}
			steps {
				build job: 'VomeSync/vomesync-ci', wait: true, propagate: true,
					parameters: [booleanParam(name: 'FORCE_RUN', value: true)]
			}
		}

		stage('Approval') {
			when {
				expression { !params.SKIP_APPROVAL }
			}
			steps {
				notifyApprovalPending("VomeSync ${env.DEPLOY_SHA} is waiting to go live on sync.vome.io")
				// Twelve hours, not three. An afternoon out was enough to lose a
				// promotion on the portal lane the same way: the input expired,
				// the build aborted, and only a later push carried the commit
				// through. A parked executor is the cheaper cost.
				timeout(time: 12, unit: 'HOURS') {
					input message: "Deploy ${env.DEPLOY_SHA} to VomeSync LIVE (sync.vome.io)?", ok: 'Yes, deploy to production'
				}
			}
		}

		stage('Deploy to LIVE') {
			steps {
				build job: env.DEPLOY_JOB_NAME, wait: true, propagate: true,
					parameters: [
						string(name: 'TARGET', value: 'live'),
						booleanParam(name: 'PULL_LATEST', value: true),
						booleanParam(name: 'NO_CACHE', value: false),
						booleanParam(name: 'RUN_TESTS_FIRST', value: false),
						booleanParam(name: 'BACKUP_BEFORE_DEPLOY', value: true),
						booleanParam(name: 'SKIP_APPROVAL', value: true),
					]
			}
		}
	}

	post {
		success {
			echo "Auto-deploy ${env.DEPLOY_SHA} → LIVE succeeded."
		}
		failure {
			echo "Auto-deploy ${env.DEPLOY_SHA} → LIVE FAILED — sync.vome.io may still be on the previous commit."
		}
	}
}
