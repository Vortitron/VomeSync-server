// =============================================================================
// VomeSync — Deployment Pipeline
//
// Deploys VomeSync Docker services (Redis, webserver, website, proxy).
// Supports DEV-only, LIVE-only, or full (all services) deploys.
// LIVE deploys require manual approval.
//
// The VomeSync repo is expected at /var/www/VomeSync-server on the host, which is
// bind-mounted into the Jenkins container.
// =============================================================================

pipeline {
    agent any

    parameters {
        // 'dev' leads because the first choice is the default. This job is
        // manual-only; push-triggered deploys go through the autodeploy
        // parents, which pass TARGET explicitly. Keep this list in step with
        // the Job DSL parameters in konhas.com/jenkins/casc.yaml.
        choice(
            name: 'TARGET',
            choices: ['dev', 'live', 'all'],
            description: 'Which service tier to deploy. Manual default is DEV — LIVE is an explicit choice (and still has an approval click unless SKIP_APPROVAL).'
        )
        booleanParam(
            name: 'PULL_LATEST',
            defaultValue: true,
            description: 'Git pull latest changes before deploying'
        )
        booleanParam(
            name: 'NO_CACHE',
            defaultValue: false,
            description: 'Build Docker images with --no-cache'
        )
        booleanParam(
            name: 'RUN_TESTS_FIRST',
            defaultValue: true,
            description: 'Run CI pipeline before deploying'
        )
        booleanParam(
            name: 'BACKUP_BEFORE_DEPLOY',
            defaultValue: true,
            description: 'Create a Redis backup before deploying live'
        )
        booleanParam(
            name: 'SKIP_APPROVAL',
            defaultValue: false,
            description: 'Skip the LIVE approval click. Auto-deploy-live sets this after it has already waited for an operator (or when branch protection is the gate).'
        )
    }

    options {
        ansiColor('xterm')
        timestamps()
        // Generous enough to cover the live approval wait — a stage timeout
        // cannot outlive the pipeline's. The actual work is capped per stage
        // below, so a hung build still dies quickly rather than idling here.
        timeout(time: 4, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '15', daysToKeepStr: '30'))
        disableConcurrentBuilds()
    }

    environment {
        VOMESYNC_DIR = '/var/www/VomeSync-server'
        DOCKER_DIR = '/var/www/VomeSync-server/docker'
    }

    stages {
        stage('Pre-flight Tests') {
            when {
                expression { params.RUN_TESTS_FIRST }
            }
            options {
                timeout(time: 40, unit: 'MINUTES')
            }
            steps {
                build job: 'VomeSync/vomesync-ci',
                      wait: true,
                      propagate: true,
                      parameters: [booleanParam(name: 'FORCE_RUN', value: true)]
            }
        }

        stage('Pull Latest') {
            when {
                expression { params.PULL_LATEST }
            }
            steps {
                sh '''
                    cd /var/www/VomeSync-server
                    if git diff --quiet && git diff --cached --quiet; then
                        git pull --ff-only || echo "WARNING: git pull failed; continuing with existing working copy"
                    else
                        echo "WARNING: Git working tree has local changes; skipping git pull"
                    fi
                '''
            }
        }

        stage('Pre-deploy Backup') {
            when {
                expression { params.BACKUP_BEFORE_DEPLOY && (params.TARGET == 'live' || params.TARGET == 'all') }
            }
            steps {
                sh '''
                    cd /var/www/VomeSync-server/docker
                    BACKUP_DIR="/var/www/VomeSync-server/backups/$(date +%Y%m%d_%H%M%S)"
                    mkdir -p "$BACKUP_DIR"
                    docker compose exec -T vomesync-redis redis-cli --rdb - > "$BACKUP_DIR/redis_dump.rdb" 2>/dev/null || true
                    cp /var/www/VomeSync-server/docker/.env "$BACKUP_DIR/" 2>/dev/null || true
                    echo "Backup created: $BACKUP_DIR"
                '''
            }
        }

        stage('Deploy DEV') {
            when {
                expression { params.TARGET == 'dev' || params.TARGET == 'all' }
            }
            options {
                timeout(time: 25, unit: 'MINUTES')
            }
            steps {
                script {
                    def cacheFlag = params.NO_CACHE ? '--no-cache' : ''
                    sh """
                        cd /var/www/VomeSync-server/docker
                        echo "Building DEV services..."
                        docker compose build ${cacheFlag} vomesync-webserver-dev
                        echo "Starting DEV services..."
                        docker compose up -d --force-recreate vomesync-redis-dev vomesync-webserver-dev vomesync-website-dev
                    """
                }
            }
        }

        // Deliberately *after* Deploy DEV. It used to sit ahead of every
        // deploy stage, which meant TARGET=all gated dev behind the live
        // approval too — a push-triggered build then deployed nothing at all
        // until someone clicked. Dev now goes out unattended and the click
        // buys only the live promotion, which is the whole point of the gate.
        stage('Approval') {
            when {
                expression {
                    (params.TARGET == 'live' || params.TARGET == 'all') && !params.SKIP_APPROVAL
                }
            }
            options {
                // VomeHome learned this one the hard way: an approval sitting
                // under a short pipeline timeout aborts every unattended
                // deploy (see docs/reliability_runbook.md, live autodeploys).
                // Wait for the operator instead of dying.
                timeout(time: 3, unit: 'HOURS')
            }
            steps {
                input message: "Deploy VomeSync to LIVE?", ok: "Yes, deploy to production"
            }
        }

        stage('Deploy LIVE') {
            when {
                expression { params.TARGET == 'live' || params.TARGET == 'all' }
            }
            options {
                timeout(time: 25, unit: 'MINUTES')
            }
            steps {
                script {
                    def cacheFlag = params.NO_CACHE ? '--no-cache' : ''
                    sh """
                        cd /var/www/VomeSync-server/docker
                        echo "Building LIVE services..."
                        docker compose build ${cacheFlag} vomesync-webserver
                        echo "Starting LIVE services..."
                        # NB: vomesync-proxy is intentionally NOT started on LIVE — this
                        # host terminates TLS with the system nginx/envoy, which already
                        # owns :8443. Recreating the container's 8443:443 binding collides
                        # with envoy and fails the whole `up`. Prod traffic goes
                        # host-nginx -> vomesync-webserver:3090/3001 directly.
                        docker compose up -d --force-recreate vomesync-redis vomesync-webserver vomesync-website
                    """
                }
            }
        }

        stage('Health Check') {
            steps {
                script {
                    sleep(time: 8, unit: 'SECONDS')

                    def hostIp = sh(
                        script: "getent hosts host.docker.internal | awk '{print \$1}' || ip route | awk '/default/ {print \$3}' || echo '172.17.0.1'",
                        returnStdout: true
                    ).trim() ?: '172.17.0.1'

                    if (params.TARGET == 'dev' || params.TARGET == 'all') {
                        def devPort = sh(
                            script: "grep '^VOMESYNC_API_DEV_HOST_PORT=' /var/www/VomeSync-server/docker/.env | cut -d= -f2",
                            returnStdout: true
                        ).trim() ?: '3091'
                        def devUrl = "http://${hostIp}:${devPort}/api/health"
                        echo "Smoke testing DEV at ${devUrl} ..."
                        def devStatus = sh(
                            script: "curl -sf -o /dev/null -w '%{http_code}' --connect-timeout 5 '${devUrl}' || echo 000",
                            returnStdout: true
                        ).trim()
                        if (devStatus == '200') {
                            echo "DEV health check passed (HTTP ${devStatus})"
                        } else {
                            echo "WARNING: DEV health check returned HTTP ${devStatus}"
                        }
                    }

                    if (params.TARGET == 'live' || params.TARGET == 'all') {
                        def livePort = sh(
                            script: "grep '^VOMESYNC_API_HOST_PORT=' /var/www/VomeSync-server/docker/.env | cut -d= -f2",
                            returnStdout: true
                        ).trim() ?: '3090'
                        def liveUrl = "http://${hostIp}:${livePort}/api/health"
                        echo "Smoke testing LIVE at ${liveUrl} ..."
                        def liveStatus = sh(
                            script: "curl -sf -o /dev/null -w '%{http_code}' --connect-timeout 5 '${liveUrl}' || echo 000",
                            returnStdout: true
                        ).trim()
                        if (liveStatus == '200') {
                            echo "LIVE health check passed (HTTP ${liveStatus})"
                        } else {
                            error("LIVE health check failed (HTTP ${liveStatus})")
                        }
                    }
                }
            }
        }

        stage('Status') {
            steps {
                sh '''
                    cd /var/www/VomeSync-server/docker
                    echo "── Container Status ──"
                    docker compose ps
                '''
            }
        }
    }

    post {
        success {
            echo "VomeSync ${params.TARGET} deployed successfully."
        }
        failure {
            echo "VomeSync ${params.TARGET} deployment failed."
        }
    }
}
