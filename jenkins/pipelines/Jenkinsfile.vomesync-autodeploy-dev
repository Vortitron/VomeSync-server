// =============================================================================
// VomeSync server — DEV auto-deploy
//
// On every push to Develop, run CI, then build the DEV backend from this
// job's checkout of that commit and prove the container runs it (see the
// Deploy to DEV stage for why this no longer hands off to vomesync-deploy,
// which still does manual and LIVE deploys).
//
// Jenkins job: VomeSync/vomesync-autodeploy-dev (provisioned from casc.yaml).
//
// GitHub webhook (same one as the other VomeSync-server jobs):
//   Payload URL:  https://<jenkins-host>/github-webhook/
//   Content type: application/json
//   Events:       push
// The webhook is the only trigger: see the note above the triggers block for
// why there is no pollSCM fallback.
// =============================================================================

pipeline {
	agent any

	options {
		ansiColor('xterm')
		timestamps()
		timeout(time: 40, unit: 'MINUTES')
		buildDiscarder(logRotator(numToKeepStr: '10', daysToKeepStr: '14'))
		disableConcurrentBuilds()
	}

	// A declarative triggers block self-registers on the job every time this
	// pipeline runs, which is why pollSCM is not here: it would put the trigger
	// straight back after any change made in casc.yaml.  It is gone because the
	// git plugin reports "Working Directory does not exist -> Changes found" on
	// every poll of these jobs, so a five-minute poll ran a full CI build every
	// five minutes forever -- thousands of them -- whether or not anything had
	// changed.  The GitHub webhook is what triggers these jobs.
	triggers {
		githubPush()
	}

	parameters {
		booleanParam(
			name: 'SKIP_TESTS',
			defaultValue: false,
			description: 'Skip the pre-flight CI run (emergency rollback only)'
		)
	}

	stages {
		stage('Resolve commit') {
			steps {
				script {
					env.DEPLOY_SHA = sh(
						script: 'git rev-parse --short HEAD',
						returnStdout: true,
					).trim()
					currentBuild.description = "→ DEV @ ${env.DEPLOY_SHA}"
					echo "Auto-deploying ${env.DEPLOY_SHA} to DEV"
				}
			}
		}

		stage('Pre-flight CI') {
			when {
				expression { !params.SKIP_TESTS }
			}
			steps {
				build job: 'VomeSync/vomesync-ci', wait: true, propagate: true,
					parameters: [booleanParam(name: 'FORCE_RUN', value: true)]
			}
		}

		stage('Deploy to DEV') {
			steps {
				// DEV is built here, from this job's own checkout of the pushed
				// Develop commit. It used to call vomesync-deploy, which builds
				// DEV from the shared host checkout after a `git pull` there; from
				// 21 to 29 Oct 2026 that pull failed on every run ("Host key
				// verification failed"), was logged as a warning, and every
				// "successful" DEV deploy restarted the old code. vomesync-deploy
				// checks out main, so it cannot build a Develop commit itself.
				// The image carries the commit and the check below refuses a
				// container that does not, the same rule LIVE has had since 21 Oct.
				//
				// The website containers (live and dev alike) serve the host
				// checkout's website/ folder, so a website change does not reach
				// sync.vome.io or dev from here. That is deliberate for now:
				// updating that folder would publish to LIVE without approval.
				script {
					env.DEV_COMMIT = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
					sh """
						echo "Building DEV from ${env.DEV_COMMIT}..."
						docker build --label vome.commit=${env.DEV_COMMIT} \\
							-t docker-vomesync-webserver-dev:latest "${env.WORKSPACE}/webserver"
						cd /var/www/VomeSync-server/docker
						docker compose up -d --no-build --force-recreate vomesync-redis-dev vomesync-webserver-dev
					"""
				}
			}
		}

		stage('Check DEV') {
			steps {
				script {
					sleep(time: 8, unit: 'SECONDS')
					def running = sh(
						script: "docker inspect -f '{{ index .Config.Labels \"vome.commit\" }}' vomesync-webserver-dev",
						returnStdout: true
					).trim()
					if (running != env.DEV_COMMIT) {
						error("DEV is running '${running}', not ${env.DEV_COMMIT}: the new build did not reach the container")
					}
					// The image's own HEALTHCHECK probes 3090; DEV listens on 3091 (PORT in compose).
					def healthy = sh(
						script: "docker exec vomesync-webserver-dev node -e \"require('http').get('http://127.0.0.1:3091/api/health', (r) => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))\"",
						returnStatus: true
					)
					if (healthy != 0) {
						error("DEV runs ${running} but its health check failed")
					}
					echo "DEV runs ${running} and is healthy"
				}
			}
		}
	}

	post {
		success {
			echo "Auto-deploy ${env.DEPLOY_SHA} → DEV succeeded."
		}
		failure {
			echo "Auto-deploy ${env.DEPLOY_SHA} → DEV FAILED — the DEV stack may still be on the previous commit."
		}
	}
}
