// =============================================================================
// VomeSync server — DEV auto-deploy
//
// On every push to main or develop, run CI then hand off to vomesync-deploy
// with TARGET=dev. That job is the single source of truth for *how* a deploy
// is performed (compose build/up, health check).
//
// Jenkins job: VomeSync/vomesync-autodeploy-dev (provisioned from casc.yaml).
//
// GitHub webhook (same one as the other VomeSync-server jobs):
//   Payload URL:  https://<jenkins-host>/github-webhook/
//   Content type: application/json
//   Events:       push
// The webhook is the only trigger: see the note above the triggers block for
// why there is no pollSCM fallback.
// =============================================================================

pipeline {
	agent any

	options {
		ansiColor('xterm')
		timestamps()
		timeout(time: 40, unit: 'MINUTES')
		buildDiscarder(logRotator(numToKeepStr: '10', daysToKeepStr: '14'))
		disableConcurrentBuilds()
	}

	// A declarative triggers block self-registers on the job every time this
	// pipeline runs, which is why pollSCM is not here: it would put the trigger
	// straight back after any change made in casc.yaml.  It is gone because the
	// git plugin reports "Working Directory does not exist -> Changes found" on
	// every poll of these jobs, so a five-minute poll ran a full CI build every
	// five minutes forever -- thousands of them -- whether or not anything had
	// changed.  The GitHub webhook is what triggers these jobs.
	triggers {
		githubPush()
	}

	parameters {
		booleanParam(
			name: 'SKIP_TESTS',
			defaultValue: false,
			description: 'Skip the pre-flight CI run (emergency rollback only)'
		)
	}

	environment {
		DEPLOY_JOB_NAME = 'VomeSync/vomesync-deploy'
	}

	stages {
		stage('Resolve commit') {
			steps {
				script {
					env.DEPLOY_SHA = sh(
						script: 'git rev-parse --short HEAD',
						returnStdout: true,
					).trim()
					currentBuild.description = "→ DEV @ ${env.DEPLOY_SHA}"
					echo "Auto-deploying ${env.DEPLOY_SHA} to DEV"
				}
			}
		}

		stage('Pre-flight CI') {
			when {
				expression { !params.SKIP_TESTS }
			}
			steps {
				build job: 'VomeSync/vomesync-ci', wait: true, propagate: true,
					parameters: [booleanParam(name: 'FORCE_RUN', value: true)]
			}
		}

		stage('Deploy to DEV') {
			steps {
				// RUN_TESTS_FIRST is always false from here: either Pre-flight CI
				// already ran vomesync-ci for this commit, or the operator skipped
				// tests. Re-running CI inside vomesync-deploy would double the wait
				// and hold the serialised deploy job for no reason.
				build job: env.DEPLOY_JOB_NAME, wait: true, propagate: true,
					parameters: [
						string(name: 'TARGET', value: 'dev'),
						booleanParam(name: 'PULL_LATEST', value: true),
						booleanParam(name: 'NO_CACHE', value: false),
						booleanParam(name: 'RUN_TESTS_FIRST', value: false),
						booleanParam(name: 'BACKUP_BEFORE_DEPLOY', value: false),
						booleanParam(name: 'SKIP_APPROVAL', value: true),
					]
			}
		}
	}

	post {
		success {
			echo "Auto-deploy ${env.DEPLOY_SHA} → DEV succeeded."
		}
		failure {
			echo "Auto-deploy ${env.DEPLOY_SHA} → DEV FAILED — the DEV stack may still be on the previous commit."
		}
	}
}
