#!/bin/sh
# fin1's second address, 95.216.77.207, carries exactly two things: the
# end-to-end router (on :443) and coturn (40000-40199). Usage: start | stop.
#
# 1. :443 is rewritten in nat PREROUTING straight to the router container's
#    fixed address on the vome_edge network (docker-compose.yml), because
#    nginx listens on 0.0.0.0:443 for every site and nothing else can bind
#    95.216.77.207:443. Going to the container directly, not through a Docker
#    port publish, keeps the visitor's address: docker-proxy would replace it.
# 2. Everything else sent to the address is dropped unless it reaches a
#    socket bound to that address *specifically*: `-m socket` ignores sockets
#    bound to 0.0.0.0 unless told otherwise (`--nowildcard` would include them).
#    The Robot firewall opens 40000-40199 to it for coturn, and programs on
#    this host with sockets on 0.0.0.0 (dnsmasq's query ports land in that
#    range) would otherwise answer there too; so would nginx on :80, Jenkins
#    and the rest. coturn and docker-proxy bind 95.216.77.207 explicitly.
# 3. Forwarded traffic never reaches INPUT. DOCKER-USER accepts exactly the
#    router's connections (sent to .207:443, now going to the router), and
#    drops every other new connection that was sent to this address, which
#    is how Docker-published ports would otherwise answer on it.
set -eu
IP=95.216.77.207
ROUTER="${VOME_E2E_ROUTER:-172.31.207.10:9443}"
ROUTER_IP="${ROUTER%:*}"; ROUTER_PORT="${ROUTER##*:}"
ALLOW="-d $ROUTER_IP/32 -p tcp --dport $ROUTER_PORT -m conntrack --ctstate NEW --ctorigdst $IP/32 --ctorigdstport 443 -m comment --comment vome-e2e -j ACCEPT"
FWD="-m conntrack --ctstate NEW --ctorigdst $IP/32 -m comment --comment vome-207 -j DROP"
DNAT="-d $IP/32 -p tcp --dport 443 -m comment --comment vome-e2e -j DNAT --to-destination $ROUTER"

# Remove every rule this script owns, whatever router it last pointed at:
# a stop with a changed VOME_E2E_ROUTER would otherwise miss the old ones.
purge() {
	# By line number, last first: deleting by the rule text -S printed fails
	# for the conntrack matches under iptables-nft ("Bad rule").
	for table_chain in "nat PREROUTING" "filter DOCKER-USER"; do
		set -- $table_chain
		iptables -t "$1" -L "$2" -n --line-numbers 2>/dev/null |
			awk '/\/\* vome-(e2e|207) \*\//{print $1}' | sort -rn |
			while read -r n; do
				iptables -t "$1" -D "$2" "$n" 2>/dev/null || true
			done
	done
}

case "${1:-}" in
start)
	purge
	iptables -t nat -C PREROUTING $DNAT 2>/dev/null || iptables -t nat -I PREROUTING 1 $DNAT
	iptables -N VOME-207 2>/dev/null || iptables -F VOME-207
	iptables -A VOME-207 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
	iptables -A VOME-207 -p icmp -j ACCEPT
	iptables -A VOME-207 -p tcp -m socket -j ACCEPT
	iptables -A VOME-207 -p udp -m socket -j ACCEPT
	iptables -A VOME-207 -j DROP
	iptables -C INPUT -d $IP/32 -j VOME-207 2>/dev/null || iptables -I INPUT 1 -d $IP/32 -j VOME-207
	iptables -C DOCKER-USER $FWD 2>/dev/null || iptables -I DOCKER-USER 1 $FWD
	iptables -C DOCKER-USER $ALLOW 2>/dev/null || iptables -I DOCKER-USER 1 $ALLOW
	;;
stop)
	purge
	iptables -D INPUT -d $IP/32 -j VOME-207 2>/dev/null || true
	iptables -F VOME-207 2>/dev/null || true
	iptables -X VOME-207 2>/dev/null || true
	;;
*)
	echo "usage: $0 start|stop" >&2
	exit 2
	;;
esac
