# VomeSync WebServer Configuration
PORT=3090
WS_PORT=3001
NODE_ENV=production

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Security
JWT_SECRET=your-jwt-secret-here-change-this-in-production
# Optional: dedicated secret for hashing bearer keys before storing in Redis.
# Defaults to JWT_SECRET if unset.
KEY_HASH_SECRET=
# Secret rotation: set OLD values when rotating secrets so existing
# sessions/keys remain valid until they are naturally re-issued.
# Remove once all clients have re-authenticated.
JWT_SECRET_OLD=
KEY_HASH_SECRET_OLD=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Maximum clock skew tolerance for V2 crypto timestamps (ms). Default: 300000 (5 min)
V2_MAX_CLOCK_SKEW_MS=300000
# Admin API key (required for admin endpoints; used for both static and HMAC auth)
ADMIN_API_KEY=
# Legacy API (v1 endpoints). Disabled by default.
LEGACY_API_ENABLED=false
# Session token flow (website). Disabled by default.
SESSION_TOKENS_ENABLED=false
# Short-lived API key duration (seconds) after session token redemption
SESSION_TOKEN_API_KEY_TTL_SECONDS=900

# Free-tier limits (set FREE_TIER_LIMITS_ENABLED=false to disable)
FREE_TIER_LIMITS_ENABLED=true
FREE_TIER_MAX_SWITCHES=15
FREE_TIER_MAX_PUBLIC_SWITCHES=10
FREE_TIER_MAX_PRIVATE_SWITCHES=5

# CAPTCHA (optional; enforced when HCAPTCHA_SECRET is set)
HCAPTCHA_SECRET=
HCAPTCHA_SITEKEY=
# For testing/staging you can set a bypass token; leave empty in production
HCAPTCHA_BYPASS_TOKEN=
# Shared secret letting the VomeHome portal publicize a switch on behalf of an
# account it already authenticated (GitHub login), without a CAPTCHA widget.
# Must match VOMESYNC_TRUSTED_CALLER_SECRET in the portal's environment.
# Leave empty to disable (portal-created switches then need publicize off).
VOMESYNC_TRUSTED_CALLER_SECRET=

# Server Configuration
CORS_ORIGINS=https://sync.vome.io,http://localhost:8123
SSL_CERT_PATH=
SSL_KEY_PATH=

# Privacy and Analytics
ENABLE_ANALYTICS=true
DIFFERENTIAL_PRIVACY_EPSILON=1.0

# Logging
LOG_LEVEL=info
LOG_FILE=logs/vomesync.log

# Paid directory promotion and owner premium (Stripe Checkout). Empty keys
# leave Promote / Upgrade hidden. Prefer a restricted key (rk_) over sk_ in
# production. Webhook URL: https://sync.vome.io/api/stripe/webhook
# (checkout.session.completed, checkout.session.async_payment_succeeded,
# customer.subscription.deleted, customer.subscription.updated).
# Do not commit live secrets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Dashboard Price IDs. If empty, STRIPE_*_AMOUNT (cents) is used instead.
STRIPE_PRICE_PROMOTE=
STRIPE_PROMOTE_AMOUNT=500
STRIPE_PROMOTE_CURRENCY=eur
STRIPE_PROMOTE_DURATION_DAYS=7
STRIPE_PRICE_PREMIUM=
STRIPE_PREMIUM_AMOUNT=900
STRIPE_PREMIUM_CURRENCY=eur
VOMESYNC_PUBLIC_BASE_URL=https://sync.vome.io

